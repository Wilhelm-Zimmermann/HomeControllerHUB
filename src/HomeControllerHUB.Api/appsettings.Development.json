{
  "ConnectionStrings": {
    "Npgsql": "Host=localhost;Port=15432;Database=db_home-controller-hub;Username=user_home-controller-hub;Password=home-controller-hubp@ss;Include Error Detail=true;SearchPath=home-hubdb,public"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationSettings": {
    "JwtSettings": {
      "SecretKey": "local-development-jwt-secret-key-change-me-32chars-minimum",
      "EncryptKey": "local-dev-key-16",
      "Issuer": "HomeControllerHUB",
      "Audience": "HomeControllerHUB",
      "NotBeforeMinutes": "0",
      "ExpirationMinutes": "600",
      "AppName": "HomeControllerHUB",
      "RefreshTokenName": "HomeControllerHUBRefreshToken"
    },
    "HostSettings": {
      "HostUrl": "http://127.0.0.1:6001/",
      "IdentityUrl": "http://127.0.0.1:6001/"
    },
    "InitializeDataBase": "true"
  },
  "Database": {
    "EnableSensitiveDataLogging": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "EmailSettings": {
    "MailgunApiKey": "your-mailgun-api-key",
    "MailgunDomain": "your-mailgun-domain",
    "FrontendUrl": "http://localhost:3000",
    "SenderEmail": "noreply@yourdomain.com",
    "SenderName": "HomeControllerHUB"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "QueueName": "homecontrollerhub.sensor-telemetry",
    "PublishTimeoutSeconds": 5
  },
  "SensorHealthMonitoring": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "OfflineThresholdMinutes": 10,
    "LowBatteryThreshold": 20
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:6001",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:7001",
        "Protocols": "Http2"
      }
    }
  }
}
